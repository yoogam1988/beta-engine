# AtomFlow 配置开关
# 用于控制企业培训场景下不需要的功能

# 隐藏计费相关功能（私有化部署不需要）
NEXT_PUBLIC_ATOMFLOW_HIDE_BILLING=1

# 隐藏插件市场（企业环境可能用不到）
NEXT_PUBLIC_ATOMFLOW_HIDE_PLUGINS=

# 隐藏 API 访问入口（终端学员不需要）
NEXT_PUBLIC_ATOMFLOW_HIDE_API_ACCESS=

# 隐藏工具导航
NEXT_PUBLIC_ATOMFLOW_HIDE_TOOLS=

# 简化模式 - 只显示学习和培训相关功能
NEXT_PUBLIC_ATOMFLOW_SIMPLIFIED_MODE=1
